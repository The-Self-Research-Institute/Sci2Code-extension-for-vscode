{
  "name": "sci2code",
  "displayName": "Sci2Code",
  "publisher": "SelfResearchInstitute",
  "author": {
    "name": "The Self Research Institute"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext"
  },
  "icon": "resources/Sci2CodeLogo.png",
  "description": "Sci2Code integrates Zotero with VS Code, letting you insert and manage references as JSDoc and PyDoc comments directly from your Zotero library, and more",
  "license": "MIT",
  "version": "1.0.2",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "onCommand:sci2code.insertZoteroCitation",
    "onCommand:sci2code.logout",
    "onCommand:zotero.refresh",
    "onCommand:zotero.search",
    "onCommand:zotero.clearFilter",
    "onView:zotero-documents",
    "onView:zotero-account"
  ],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
"configuration": {
    "title": "Sci2Code",
    "properties": {
      "sci2code.triggers": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": ["\"\"\"", "#", "#'", "/**"],
        "description": "Global trigger characters/strings"
      },
      "sci2code.templates": {
        "type": "object",
        "description": "Define custom documentation templates for each language. Use the placeholders below to insert data from Zotero and the current code context.\n\n**Available Zotero Placeholders:**\n- `${zotero.title}`: The title of the item.\n- `${zotero.creators}`: A comma-separated list of authors/creators.\n- `${zotero.DOI}`: The Digital Object Identifier.\n- `${zotero.ISBN}`: The International Standard Book Number.\n- `${zotero.ISSN}`: The International Standard Serial Number.\n- `${zotero.itemType}`: The type of the Zotero item (e.g., journalArticle).\n- `${zotero.date}`: The publication date.\n- `${zotero.publicationTitle}`: The title of the journal or book.\n- `${zotero.url}`: The URL link to the item.\n- `${zotero.key}`: The unique Zotero item key.\n\n**Available Code Placeholders:**\n- `${code.id}`: The unique ID generated for the code-reference link.\n- `${code.functionName}`: The name of the function being documented.",
        "default": {
          "default": "/**\n * @Title: ${zotero.title}\n * @Authors: ${zotero.creators}\n * @DOI: ${zotero.DOI}\n * @CodeID: ${code.id}\n */",
          "python": "\"\"\"\nTitle: ${zotero.title}\nAuthors: ${zotero.creators}\nDOI: ${zotero.DOI}\nCodeID: ${code.id}\n\"\"\"",
          "r": "#' @Title ${zotero.title}\n#' @Author ${zotero.creators}\n#' @DOI ${zotero.DOI}\n#' @CodeID ${code.id}",
          "julia": "\"\"\"\n    Brief description\n\n    # Metadata\n    - **Title**: ${zotero.title}\n    - **Authors**: ${zotero.creators}\n    - **DOI**: ${zotero.DOI}\n    - **CodeID**: ${code.id}\n\"\"\""
        },
        "additionalProperties": {
          "type": "string",
          "description": "Template for a specific language ID. See the main description for a full list of available placeholders."
        }
      },
      "sci2code.languageSpecificTriggers": {
        "type": "object",
        "description": "Language-specific trigger configurations",
        "default": {
          "javascript": ["/**", "//"],
          "python": ["\"\"\"", "#"],
          "julia": ["\"\"\"", "#"],
          "typescript": ["/**", "//"],
          "r": ["#'", "#"]
        },
        "properties": {
          "javascript": {
            "type": "array",
            "items": { "type": "string" }
          },
          "python": {
            "type": "array",
            "items": { "type": "string" }
          },
          "typescript": {
            "type": "array",
            "items": { "type": "string" }
          },
          "java": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  },
    "commands": [
      {
        "command": "sci2code.insertZoteroCitation",
        "title": "Sci2Code: Insert Zotero Citation"
      },
       {
        "command": "sci2code.logout",
        "title": "Sci2Code: Logout"
      },
      {
        "command": "zotero.refresh",
        "title": "Refresh Library",
        "icon": "$(refresh)"
      },
      {
        "command": "zotero.search",
        "title": "Search Library",
        "icon": "$(search)"
      },
      {
        "command": "zotero.clearFilter",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "zotero.search",
          "when": "view == zotero-documents",
          "group": "navigation@1"
        },
        {
          "command": "zotero.clearFilter",
          "when": "view == zotero-documents",
          "group": "navigation@2"
        },
        {
          "command": "zotero.refresh",
          "when": "view == zotero-documents",
          "group": "navigation@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zotero-explorer",
          "title": "Zotero",
          "icon": "resources/zotero.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zotero-account",
        "contents": "Login to access Zotero",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "[Login to Zotero](command:sci2code.login)",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "You will need zotero API Key to connect your zotero account. You can get the Zotero API key from [here](https://www.zotero.org/settings/keys).",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "Thanks for connecting with Zotero",
        "when": "zotero:loggedIn"
      },
      {
        "view": "zotero-documents",
        "contents": "Authenticate to view your Zotero Documents",
        "when": "!zotero:loggedIn"
      }
    ],
    "keybindings": [
      {
        "command": "sci2code.insertZoteroCitation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "zotero-explorer": [
        {
          "id": "zotero-account",
          "name": "Zotero Account"
        },
        {
          "id": "zotero-documents",
          "name": "Zotero Documents"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vscode-test",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=./",
    "compile-web": "webpack --config webpack.config.js --mode development --watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "~20.17.6",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/test-web": "*",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.57.1",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webpack": "^5.99.9",
    "webpack-cli": "^5.1.4"
  }
}
