{
  "name": "sci2code",
  "displayName": "Sci2Code",
  "publisher": "SelfResearchInstitute",
  "author": {
    "name": "The Self Research Institute"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext"
  },
  "icon": "resources/Sci2CodeLogo.png",
  "description": "Sci2Code integrates Zotero with VS Code, letting you insert and manage references as JSDoc and PyDoc comments directly from your Zotero library, and more",
  "license": "MIT",
  "version": "1.0.2",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sci2code.login",
        "title": "Zotero Login"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zotero-explorer",
          "title": "Zotero",
          "icon": "resources/zotero.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zotero-account",
        "contents": "Login to access Zotero",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "[Login to Zotero](command:sci2code.login)",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "You will need zotero API Key to connect your zotero account. You can get the Zotero API key from [here](https://www.zotero.org/settings/keys).",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "Thanks for connecting with Zotero",
        "when": "zotero:loggedIn"
      },
      {
        "view": "zotero-documents",
        "contents": "Authenticate to view your Zotero Documents",
        "when": "!zotero:loggedIn"
      }
    ],
    "views": {
      "zotero-explorer": [
        {
          "id": "zotero-account",
          "name": "Zotero Account"
        },
        {
          "id": "zotero-documents",
          "name": "Zotero Documents"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vscode-test",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=./",
    "compile-web": "webpack --config webpack.config.js --mode development --watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "~20.17.6",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/test-web": "*",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.57.1",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webpack": "^5.99.9",
    "webpack-cli": "^5.1.4"
  }
}
