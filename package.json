{
  "name": "sci2code",
  "displayName": "Sci2Code",
  "publisher": "SelfResearchInstitute",
  "author": {
    "name": "The Self Research Institute"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext"
  },
  "bugs": {
    "url": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext/issues",
    "email": "support@selfresearch.org"
  },
  "homepage": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext#readme",
  "qna": "https://github.com/The-Self-Research-Institute/zotero_vscode_ext/discussions",
  "icon": "resources/Sci2CodeLogo.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "description": "Sci2Code integrates Zotero with VS Code, letting you insert and manage references as JSDoc and PyDoc comments directly from your Zotero library, and more",
  "license": "GPL-3.0-or-later",
  "version": "1.0.4",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Data Science",
    "Education"
  ],
  "keywords": [
    "zotero",
    "citation",
    "reference manager",
    "research",
    "academic",
    "jsdoc",
    "pydoc",
    "bibliography",
    "scientific",
    "data science",
    "reproducibility"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Sci2Code",
      "properties": {
        "sci2code.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your Zotero API key with read/write access. Get it from [Zotero API Settings](https://www.zotero.org/settings/keys).\n\n**Security note:** this value is stored locally in your VS Code user settings. It is excluded from Settings Sync, but anyone with access to your machine can read it. The key is also copied into VS Code's secret storage for API calls.",
          "scope": "application",
          "ignoreSync": true,
          "order": 0
        },
        "sci2code.triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "\"\"\"",
            "#",
            "#'",
            "/**"
          ],
          "markdownDescription": "Global comment-trigger strings. When you type any of these above a function, Sci2Code offers a citation completion.\n\nThese triggers apply to **every** language. To add extra triggers for a single language, use `#sci2code.languageSpecificTriggers#` — values there are **merged** with this list, not overridden."
        },
        "sci2code.templates": {
          "type": "object",
          "description": "Customize the documentation snippets that are inserted into your code.\n\n**How It Works**:\nThe key is a VS Code Language ID (e.g., `python`) and the value is an array of strings, where each string is a new line.\n\n**Available Placeholders**:\n\n**Common Placeholders**:\n- `${zotero.title}`: The main title of the item.\n- `${zotero.creators}`: A comma-separated list of authors.\n- `${zotero.date}`: The publication year.\n- `${zotero.DOI}`: The Digital Object Identifier.\n- `${zotero.publicationTitle}`: The title of the journal or book.\n- `${zotero.url}`: The URL link to the item.\n- `${zotero.itemType}`: The type of Zotero item (e.g., 'journalArticle').\n- `${zotero.key}`: The unique Zotero item key.\n\n**Code Context**:\n- `${code.id}`: The unique ID linking the code to the Zotero item.\n- `${code.functionName}`: The name of the function being documented.",
          "default": {
            "default": [
              "// Zotero Reference",
              "// Title: ${zotero.title}",
              "// Authors: ${zotero.creators}",
              "// Year: ${zotero.date}",
              "// DOI: ${zotero.DOI}",
              "// URL: ${zotero.url}",
              "// Zotero Key: ${zotero.key}",
              "// Code ID: ${code.id}"
            ],
            "javascript": [
              "/**",
              " * @ZoteroArticleNames ${zotero.title}",
              " * @ZoteroArticleIDs ${zotero.key}",
              " * @ZoteroArticleURLs ${zotero.url}",
              " * @ZoteroDOI ${zotero.DOI}",
              " * @CodeID ${code.id}",
              " */"
            ],
            "typescript": [
              "/**",
              " * @ZoteroArticleNames ${zotero.title}",
              " * @ZoteroArticleIDs ${zotero.key}",
              " * @ZoteroArticleURLs ${zotero.url}",
              " * @ZoteroDOI ${zotero.DOI}",
              " * @CodeID ${code.id}",
              " */"
            ],
            "python": [
              "\"\"\"",
              "Zotero Reference:",
              "    Title: ${zotero.title}",
              "    Authors: ${zotero.creators}",
              "    Year: ${zotero.date}",
              "    DOI: ${zotero.DOI}",
              "    URL: ${zotero.url}",
              "    Key: ${zotero.key}",
              "    CodeID: ${code.id}",
              "\"\"\""
            ],
            "r": [
              "#'",
              "#' @ZoteroArticleIDs: ${zotero.key}",
              "#' @ZoteroitemType: ${zotero.itemType}",
              "#' @ZoteroArticleNames: ${zotero.title}",
              "#' @ZoteroArticleURLs: ${zotero.url}",
              "#' @ZoteroDOI: ${zotero.DOI}",
              "#' @CodeID: ${code.id}",
              "#'"
            ],
            "julia": [
              "\"\"\"",
              "Reference: ${zotero.title}",
              "Authors: ${zotero.creators}",
              "DOI: ${zotero.DOI}",
              "URL: ${zotero.url}",
              "Zotero Key: ${zotero.key}",
              "Code ID: ${code.id}",
              "\"\"\""
            ]
          }
        },
        "sci2code.languageSpecificTriggers": {
          "type": "object",
          "markdownDescription": "Extra comment triggers scoped to a specific language. Values are **added to** `#sci2code.triggers#` for that language (they do not replace it). The key is a VS Code language id such as `python`, `javascript`, `typescript`, `r`, `julia`.",
          "default": {
            "javascript": [
              "/**",
              "//"
            ],
            "python": [
              "\"\"\"",
              "#"
            ],
            "julia": [
              "\"\"\"",
              "#"
            ],
            "typescript": [
              "/**",
              "//"
            ],
            "r": [
              "#'",
              "#"
            ]
          },
          "properties": {
            "javascript": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "typescript": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "python": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "r": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "julia": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "commands": [
      {
        "command": "sci2code.openSettings",
        "title": "Sci2Code: Open Settings"
      },
      {
        "command": "sci2code.editTemplateForCurrentLanguage",
        "title": "Sci2Code: Edit Citation Template for Current Language"
      },
      {
        "command": "sci2code.resetTemplates",
        "title": "Sci2Code: Reset Citation Templates to Default"
      },
      {
        "command": "sci2code.showLogs",
        "title": "Sci2Code: Show Logs"
      },
      {
        "command": "sci2code.login",
        "title": "Sci2Code: Login to Zotero"
      },
      {
        "command": "sci2code.insertZoteroCitation",
        "title": "Sci2Code: Insert Zotero Citation"
      },
      {
        "command": "sci2code.insertManualCitation",
        "title": "Sci2Code: Insert Manual Citation"
      },
      {
        "command": "sci2code.insertCitationFromSidebar",
        "title": "Sci2Code: Insert Citation From Sidebar"
      },
      {
        "command": "sci2code.logout",
        "title": "Sci2Code: Logout"
      },
      {
        "command": "zotero.refresh",
        "title": "Refresh Library",
        "icon": "$(refresh)"
      },
      {
        "command": "zotero.search",
        "title": "Search Library",
        "icon": "$(search)"
      },
      {
        "command": "zotero.clearFilter",
        "title": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "zotero.sort",
        "title": "Sort Zotero Documents",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "zotero.copyDOI",
        "title": "Copy DOI"
      },
      {
        "command": "zotero.copyKey",
        "title": "Copy Zotero Key"
      },
      {
        "command": "zotero.openOnWeb",
        "title": "Open on zotero.org"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sci2code.insertCitationFromSidebar",
          "when": "false"
        },
        {
          "command": "zotero.copyDOI",
          "when": "false"
        },
        {
          "command": "zotero.copyKey",
          "when": "false"
        },
        {
          "command": "zotero.openOnWeb",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "zotero.search",
          "when": "view == zotero-documents",
          "group": "navigation@1"
        },
        {
          "command": "zotero.clearFilter",
          "when": "view == zotero-documents && zotero:hasFilter",
          "group": "navigation@2"
        },
        {
          "command": "zotero.sort",
          "when": "view == zotero-documents",
          "group": "navigation@3"
        },
        {
          "command": "zotero.refresh",
          "when": "view == zotero-documents",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "zotero.copyDOI",
          "when": "view == zotero-documents && viewItem == zoteroItem",
          "group": "1_copy@1"
        },
        {
          "command": "zotero.copyKey",
          "when": "view == zotero-documents && viewItem == zoteroItem",
          "group": "1_copy@2"
        },
        {
          "command": "zotero.openOnWeb",
          "when": "view == zotero-documents && viewItem == zoteroItem",
          "group": "2_open@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zotero-explorer",
          "title": "Zotero",
          "icon": "resources/zotero.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zotero-account",
        "contents": "Login to access Zotero",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "[Login to Zotero](command:sci2code.login)",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "You will need zotero API Key to connect your zotero account. You can get the Zotero API key from [here](https://www.zotero.org/settings/keys).",
        "when": "!zotero:loggedIn"
      },
      {
        "view": "zotero-account",
        "contents": "Thanks for connecting with Zotero",
        "when": "zotero:loggedIn"
      },
      {
        "view": "zotero-documents",
        "contents": "Authenticate to view your Zotero Documents",
        "when": "!zotero:loggedIn"
      }
    ],
    "keybindings": [
      {
        "command": "sci2code.insertZoteroCitation",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus"
      }
    ],
    "views": {
      "zotero-explorer": [
        {
          "id": "zotero-account",
          "name": "Zotero Account"
        },
        {
          "id": "zotero-documents",
          "name": "Zotero Documents"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "vscode-test",
    "test-web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=./",
    "compile-web": "webpack --config webpack.config.js --mode development --watch",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.9",
    "@types/node": "~20.17.6",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.1",
    "@vscode/test-web": "*",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "eslint": "^8.57.1",
    "https-browserify": "^1.0.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "webpack": "^5.99.9",
    "webpack-cli": "^5.1.4"
  }
}
